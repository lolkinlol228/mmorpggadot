], [1551, 1610, 32], [1551, 1624, 32], [1551, 1638, 32]], "zones": {"spawn": [1020, 1005], "town": [800, 850, 1240, 1170], "slime": [1010, 470, 247.5, 150.0], "wolf": [1720, 680, 2340, 1380], "golem": [2060, 330], "npcs": [["Мира", "торговка", 1175, 950, {"race": "elf", "skin": "pale", "hair": "long", "hair_color": "red"}, {"body": ["robe", 1]}, "down"], ["Горн", "кузнец", 930, 946, {"race": "dwarf", "skin": "mid", "hair": "short", "hair_color": "red"}, {"body": ["armor", 0], "weapon": ["axe", 0]}, "down"], ["Стражник", "у ворот", 978, 836, {"skin": "light", "hair": "short", "hair_color": "brown"}, {"body": ["armor", 1], "head": ["helm", 1], "weapon": ["sword", 1]}, "down"], ["Стражник", "у ворот", 1064, 836, {"skin": "mid", "hair": "short", "hair_color": "black"}, {"body": ["armor", 1], "head": ["helm", 1], "weapon": ["sword", 1]}, "down"], ["Стражница", "у ворот", 1262, 1050, {"race": "felin", "skin": "light", "hair": "tail", "hair_color": "blond"}, {"body": ["armor", 1], "weapon": ["sword", 1]}, "side_left"], ["Лина", "жительница", 1050, 1084, {"skin": "light", "hair": "tail", "hair_color": "blond"}, {}, "side_left"], ["Старый Ив", "трактирщик", 944, 1130, {"race": "human", "skin": "light", "hair": "short", "hair_color": "white"}, {}, "down"], ["Рыбак", "у моста", 1622, 1052, {"race": "orc", "skin": "olive", "hair": "spiky", "hair_color": "black"}, {"feet": ["boots", 0]}, "side_left"]], "chimneys": [[880, 935, "forge"], [1150, 905, "house"], [880, 1150, "tavern"], [1165, 1150, "house"]], "interact": [{"kind": "bank", "x": 1066, "y": 999, "h": 22, "label": "Хранилище"}, {"kind": "shop", "x": 1175, "y": 962, "h": 50, "label": "Лавка Миры"}, {"kind": "board", "x": 972, "y": 965, "h": 40, "label": "Доска заказов"}, {"kind": "talk", "x": 930, "y": 946, "h": 46, "label": "Горн, кузнец", "lines": ["Наковальня остынет — тогда и поговорим об улучшении оружия. Скоро.", "Волчьи клыки тупят даже хорошую сталь. Береги клинок за мостом.", "Видел я Клинок Бездны однажды. Холодный, как дно колодца."]}, {"kind": "talk", "x": 978, "y": 836, "h": 46, "label": "Стражник", "lines": ["На север — Слизневая топь. Для новичков самое то.", "Внутри стен ни одна тварь тебя не тронет. Город под защитой."]}, {"kind": "talk", "x": 1064, "y": 836, "h": 46, "label": "Стражник", "lines": ["Говорят, в Круге Голема по ночам светятся руны.", "Сдавай добычу в хранилище — сумка не резиновая."]}, {"kind": "talk", "x": 1262, "y": 1050, "h": 46, "label": "Стражница", "lines": ["Мост — граница. Дальше волки, и ходят они стаями.", "Без зелий в Волчий лес не суйся. Мира продаёт."]}, {"kind": "talk", "x": 1050, "y": 1084, "h": 46, "label": "Лина", "lines": ["Говорят, раз в тысячу находок вещь выходит сияющей!", "Вода в колодце ледяная даже летом."]}, {"kind": "talk", "x": 944, "y": 1130, "h": 46, "label": "Старый Ив", "lines": ["Таверна закрыта на ремонт, но у костра место всегда найдётся.", "Платиновый Осколок Удачи... за жизнь видел всего два."]}, {"kind": "talk", "x": 1622, "y": 1052, "h": 46, "label": "Рыбак", "lines": ["Клюёт плохо. Волки распугали всю рыбу.", "За мостом держись дороги — в чаще легко заблудиться."]}], "labels": [["Пепельный Брод", 1020, 816], ["Слизневая топь", 1010, 260], ["Волчий лес", 2010, 630], ["Круг Голема", 2060, 137]]}, "size": [2400, 1600]}