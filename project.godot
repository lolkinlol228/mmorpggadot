; Engine configuration file.
config_version=5

[application]

config/name="Осколки Удачи"
config/description="Кооперативная 2D-RPG с редким лутом и обменом"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Items="*res://scripts/items.gd"
Rules="*res://scripts/rules.gd"
Save="*res://scripts/save.gd"
Net="*res://scripts/net.gd"
Sfx="*res://scripts/sfx.gd"
World="*res://scripts/world_data.gd"
Tips="*res://scripts/tips.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://assets/fonts/silver_ui.tres"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
timers/tooltip_delay_sec=1000.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
